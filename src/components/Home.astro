---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Work from './Work.astro';
import Publications from './Publications.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import { routes, type Lang } from '../data/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'pt' ? 'en' : 'pt';
---
<Base lang={lang} page="home" path={routes[lang].home} altPath={routes[other].home}>
  <Hero lang={lang} />
  <Projects lang={lang} />
  <Work lang={lang} />
  <Publications lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
</Base>
