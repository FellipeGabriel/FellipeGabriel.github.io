---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { ui, routes, type Lang } from '../data/content';
import { projects } from '../data/projects';
import { sectionIds } from '../data/sections';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].projects;
const list = projects[lang];
const titleWidth = (name: string) => (name.length <= 6 ? 125 : 62);
---
<section id={sectionIds[lang].projects} class="projects" aria-labelledby="projects-title" data-projects>
  <div class="track" data-track>
    <div class="panel panel-intro field-paper" data-field="paper">
      <h2 id="projects-title" class="display intro-title" data-fit data-split>{t.heading}</h2>
      <p class="lead">{t.lead}</p>
    </div>

    {list.map((p) => (
      <article
        class={`panel panel-project field-${p.field} project-${p.slug}`}
        data-field={p.field}
        data-panel
        style={`--title-wdth:${titleWidth(p.name)}`}
        aria-labelledby={`p-${p.slug}`}
      >
        <h3 id={`p-${p.slug}`} class="display project-title" style={`view-transition-name: title-${p.slug}`}>
          {p.name}
        </h3>

        <div class="plate project-plate" data-plate style={`view-transition-name: plate-${p.slug}`}>
          {p.slug === 'lyfia' ? (
            <>
              <div class="shot shot-main" data-depth="0.06">
                <Picture src={p.cover.src} formats={['avif', 'webp']} widths={[800, 1300, 2000]} sizes="(max-width: 760px) 100vw, 58vw" alt={p.cover.alt} loading="lazy" />
              </div>
              <div class="shot shot-phone" data-depth="-0.12">
                <Picture src={p.secondary[0].src} formats={['avif', 'webp']} widths={[300, 520]} sizes="(max-width: 760px) 30vw, 13vw" alt={p.secondary[0].alt} loading="lazy" />
              </div>
            </>
          ) : (
            <div class="phones">
              {[p.cover, ...p.secondary].map((s, i) => (
                <div class={`shot shot-phone phone-${i}`} data-depth={[0.05, -0.06, 0.07][i]}>
                  <Picture src={s.src} formats={['avif', 'webp']} widths={[300, 560]} sizes="(max-width: 760px) 30vw, 14vw" alt={s.alt} loading="lazy" />
                </div>
              ))}
            </div>
          )}
          <p class="display project-ghost" aria-hidden="true">{p.name}</p>
        </div>

        <div class="project-body">
          <p class="label project-kind">{p.kind}</p>
          <p class="lead">{p.lead}</p>
          <ul class="facts">
            {p.facts.map((f) => <li>{f}</li>)}
          </ul>
          <div class="project-links">
            <a class="btn btn-solid" href={routes[lang].project(p.slug)}>{t.howItWasMade}<Icon name="arrow-right" /></a>
            {p.links.map((l) => (
              <a class="arrow-link" href={l.href} target="_blank" rel="noopener">{l.label}<Icon name="arrow-up-right" /></a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="track-progress" aria-hidden="true"><span data-track-progress></span></div>
</section>

<style>
  .projects {
    position: relative;
  }
  .track {
    display: flex;
    flex-direction: column;
  }
  .panel {
    position: relative;
    container-type: inline-size;
    padding: clamp(5rem, 12svh, 8rem) var(--pad) var(--pad);
  }
  .panel-intro {
    display: grid;
    align-content: space-between;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .panel-intro {
      min-height: 70svh;
    }
  }
  .intro-title {
    font-size: clamp(3.5rem, 12vw, 22rem);
  }

  .panel-project {
    --title-size: 13.5cqw;
    --plate-l: 42cqw;
    --plate-t: clamp(5rem, 14svh, 9rem);
    --title-top: clamp(4.25rem, 9svh, 6rem);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .field-cobalt {
    --ghost: var(--cobalt);
    --plate-bg: var(--paper);
  }
  .field-ink {
    --ghost: var(--ink);
    --plate-bg: var(--orange);
  }
  .field-ink .project-title {
    color: var(--orange);
  }
  .project-title,
  .project-ghost {
    font-variation-settings: 'wdth' var(--title-wdth, 62);
  }
  .project-title {
    position: absolute;
    top: var(--title-top);
    left: var(--pad);
    font-size: var(--title-size);
    line-height: 0.8;
    z-index: 2;
    white-space: nowrap;
  }
  .project-plate {
    position: absolute;
    top: var(--plate-t);
    left: var(--plate-l);
    right: var(--pad);
    bottom: var(--pad);
    background: var(--plate-bg);
    z-index: 3;
  }
  .project-ghost {
    position: absolute;
    left: calc(var(--pad) - var(--plate-l));
    top: calc(var(--title-top) - var(--plate-t));
    font-size: var(--title-size);
    line-height: 0.8;
    color: var(--ghost);
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }
  .shot {
    position: absolute;
    overflow: hidden;
  }
  .shot :global(picture),
  .shot :global(img) {
    width: 100%;
    height: 100%;
  }
  .shot :global(img) {
    object-fit: cover;
    object-position: 0 0;
  }
  .project-lyfia .shot-main {
    inset: 0 -6% 0 0;
  }
  .project-lyfia .shot-phone {
    width: 22%;
    aspect-ratio: 390 / 844;
    right: 5%;
    bottom: -8%;
    border: 6px solid var(--ink);
    z-index: 3;
  }
  .phones .shot-phone {
    width: 30%;
    aspect-ratio: 720 / 1300;
    border: 6px solid var(--ink);
    background: var(--ink);
  }
  .phone-0 {
    left: 3%;
    bottom: 9%;
  }
  .phone-1 {
    left: 35%;
    bottom: 3%;
  }
  .phone-2 {
    left: 67%;
    bottom: 15%;
  }

  .project-body {
    position: relative;
    z-index: 2;
    margin-top: auto;
    max-width: calc(var(--plate-l) - var(--pad) * 2);
    display: grid;
    gap: 1rem;
  }
  .project-kind {
    color: var(--accent);
  }
  .field-cobalt .project-kind {
    color: var(--paper);
  }
  .facts {
    border-top: var(--rule) solid currentColor;
  }
  .facts li {
    padding: 0.55rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    font-size: var(--step-0);
    line-height: 1.35;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
  }

  .track-progress {
    display: none;
  }

  @media (min-width: 900px) {
    :global(html.motion) .track {
      flex-direction: row;
      width: max-content;
      height: 100svh;
    }
    :global(html.motion) .panel {
      height: 100svh;
      min-height: 0;
      flex: none;
    }
    :global(html.motion) .panel-intro {
      width: 58vw;
    }
    :global(html.motion) .panel-project {
      width: 100vw;
    }
    :global(html.motion) .track-progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 4px;
      z-index: 5;
    }
    .track-progress span {
      display: block;
      height: 100%;
      width: 100%;
      background: var(--orange);
      transform-origin: 0 50%;
      transform: scaleX(0);
    }
  }

  @media (min-width: 900px) and (max-height: 760px) {
    .panel-project .lead {
      font-size: var(--step-0);
    }
    .facts li {
      padding: 0.35rem 0;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 899px) {
    .panel-project {
      min-height: 0;
      padding-top: 4.5rem;
    }
    .project-title {
      position: relative;
      top: auto;
      left: auto;
      font-size: min(var(--title-size) * 1.3, 24cqw);
    }
    .project-plate {
      position: relative;
      inset: auto;
      margin-top: 1.25rem;
      aspect-ratio: 4 / 3;
    }
    .project-ghost {
      display: none;
    }
    .project-lyfia .shot-main {
      inset: 0;
    }
    .project-body {
      max-width: none;
      margin-top: 1.75rem;
    }
  }
</style>
