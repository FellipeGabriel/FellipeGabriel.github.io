---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ProjectLink from './ProjectLink.astro';
import QrCode from './QrCode.astro';
import officeNight from '../assets/photos/office-night.jpg';
import { ui, routes, type Lang } from '../data/content';
import { projects } from '../data/projects';
import { sectionIds } from '../data/sections';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].projects;
const list = projects[lang];
const titleWidth = (name: string) => (name.length <= 6 ? 125 : 62);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id={sectionIds[lang].projects} class="projects" aria-labelledby="projects-title" data-projects>
  <div class="panel-intro field-ink" data-field="ink">
    <div class="intro-img projector" aria-hidden="true">
      <Picture quality={88} src={officeNight} formats={['avif', 'webp']} widths={[1000, 1600, 2400]} sizes="100vw" alt="" loading="lazy" />
    </div>
    <h2 id="projects-title" class="display intro-title" data-fit data-split>{t.heading}</h2>
    <div class="intro-foot">
      <p class="lead">{t.lead}</p>
      <ol class="intro-index">
        {list.map((p) => (
          <li>
            <a href={routes[lang].project(p.slug)}>
              <span class="intro-name">{p.name}</span>
              <span class="label">{p.kind}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>

  {list.map((p, i) => (
    <article
      class={`project field-${p.field} project-${p.slug}`}
      data-field={p.field}
      data-panel
      style={`--title-wdth:${titleWidth(p.name)}`}
      aria-labelledby={`p-${p.slug}`}
    >
      <header class="project-head">
        <h3 id={`p-${p.slug}`} class="display project-title" style={`view-transition-name: title-${p.slug}`} data-project-title>
          {p.name}
        </h3>
        <p class="label project-meta">
          <span class="tnum">{pad(i + 1)} / {pad(list.length)}</span>
          <span class="project-kind">{p.kind}</span>
        </p>
      </header>

      <p class="lead project-lead" data-project-lead>{p.lead}</p>

      <div class={`plate project-plate plate-${p.slug}`} style={`view-transition-name: plate-${p.slug}`} data-plate>
        {p.slug === 'lyfia' ? (
          <div class="screens">
            <figure class="screen screen-desktop" data-shot>
              <Picture quality={88} src={p.cover.src} formats={['avif', 'webp']} widths={[800, 1300, 2000, 2880]} sizes="(max-width: 899px) 70vw, 68vw" alt={p.cover.alt} loading="lazy" />
            </figure>
            <figure class="screen screen-phone" data-shot data-depth="-0.08">
              <Picture quality={88} src={p.secondary[0].src} formats={['avif', 'webp']} widths={[300, 520, 800]} sizes="(max-width: 899px) 22vw, 16vw" alt={p.secondary[0].alt} loading="lazy" />
            </figure>
          </div>
        ) : (
          <div class="phones">
            {[p.cover, ...p.secondary].map((s) => (
              <figure class="phone" data-shot>
                <Picture quality={88} src={s.src} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 899px) 30vw, 20vw" alt={s.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        )}
        {p.qr && <QrCode url={p.qr.url} label={p.qr.label} class="plate-qr" />}
      </div>

      <div class="project-body">
        <ul class="facts" data-facts>
          {p.facts.map((f) => <li>{f}</li>)}
        </ul>
        <div class="project-links">
          <a class="btn btn-solid" href={routes[lang].project(p.slug)}>{t.howItWasMade}<Icon name="arrow-right" /></a>
          {p.links.map((l) => <ProjectLink href={l.href} label={l.label} kind={l.kind} />)}
        </div>
      </div>
    </article>
  ))}
</section>

<style>
  .projects {
    position: relative;
  }

  /* Abertura: foto de borda a borda com o título por cima. */
  .panel-intro {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-height: 100svh;
    padding: clamp(5rem, 12svh, 8rem) var(--pad) var(--pad);
    overflow: hidden;
  }
  .intro-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--ink);
  }
  .intro-img :global(picture),
  .intro-img :global(img) {
    width: 100%;
    height: 100%;
  }
  .intro-img :global(img) {
    object-fit: cover;
    object-position: 50% 50%;
  }
  .intro-title {
    position: relative;
    z-index: 1;
    color: var(--paper);
    font-size: clamp(3.5rem, 15vw, 22rem);
  }
  .intro-foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: end;
  }
  .intro-foot .lead {
    grid-column: 1 / span 5;
    background: var(--ink);
    padding: 1.25rem 1.5rem;
    max-width: none;
  }
  .intro-index {
    grid-column: 7 / -1;
    display: grid;
    background: var(--ink);
    padding: 0.5rem 1.5rem;
  }
  .intro-index li + li {
    border-top: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
  }
  .intro-index a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }
  .intro-index a:hover {
    color: var(--amber);
  }
  .intro-name {
    font-size: var(--step-3);
    font-weight: 900;
    font-variation-settings: 'wdth' 62;
    text-transform: uppercase;
    line-height: 0.9;
  }

  /* Cartaz de projeto: nome, frase, telas inteiras, fatos e links, nessa ordem. */
  .project {
    padding: clamp(5rem, 13svh, 9rem) var(--pad) clamp(4rem, 11svh, 8rem);
  }
  .field-petrol {
    --plate-bg: var(--lyfia-cream);
  }
  .field-ink {
    --plate-bg: var(--recupera-green);
  }
  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem var(--gutter);
  }
  .project-title {
    font-size: clamp(3.5rem, 12vw, 13rem);
    font-variation-settings: 'wdth' var(--title-wdth, 62);
    line-height: 0.8;
    white-space: nowrap;
    margin-left: -0.02em;
  }
  .field-ink .project-title {
    color: var(--amber);
  }
  .project-meta {
    display: grid;
    gap: 0.2rem;
    text-align: right;
    padding-bottom: 0.2em;
  }
  .project-kind {
    color: var(--accent);
  }
  .project-lead {
    margin-top: clamp(1.5rem, 4svh, 2.75rem);
    font-size: clamp(1.35rem, 1.05rem + 1.1vw, 2.15rem);
    line-height: 1.22;
    max-width: 36ch;
  }

  .project-plate {
    position: relative;
    margin-top: clamp(2rem, 5svh, 3.5rem);
    background: var(--plate-bg);
    padding: clamp(1.25rem, 4.5vw, 5rem);
  }
  .screen {
    margin: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .screen :global(picture),
  .screen :global(img),
  .phone :global(picture),
  .phone :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .screen :global(img),
  .phone :global(img) {
    object-fit: cover;
    object-position: 50% 0;
  }
  .screens {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 3vw, 3.5rem);
  }
  .screen-desktop {
    flex: 1;
    aspect-ratio: 2880 / 1800;
    border: var(--rule) solid var(--ink);
  }
  .screen-phone {
    flex: none;
    width: 21%;
    aspect-ratio: 1170 / 2532;
    border: 6px solid var(--ink);
  }
  .phones {
    display: flex;
    justify-content: center;
    gap: clamp(0.75rem, 4vw, 4.5rem);
  }
  .phone {
    margin: 0;
    flex: none;
    /* A placa inteira cabe na tela: a largura do celular segue a altura da viewport. */
    width: min(28%, 300px, (100svh - 13rem) * 0.47);
    aspect-ratio: 720 / 1530;
    border: 6px solid var(--ink);
    background: var(--ink);
    overflow: hidden;
  }
  .project-plate :global(.plate-qr) {
    position: absolute;
    top: clamp(1.25rem, 3vw, 2.5rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    color: var(--ink);
  }
  .project-plate :global(.plate-qr .qr-code) {
    width: 6.5rem;
  }
  .project-plate :global(.plate-qr .qr-label) {
    max-width: 15ch;
    text-align: right;
    font-weight: 500;
  }

  .project-body {
    margin-top: clamp(2rem, 5svh, 3.5rem);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem var(--gutter);
    align-items: start;
  }
  .facts {
    grid-column: 1 / span 7;
    border-top: var(--rule) solid currentColor;
  }
  .facts li {
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    font-size: var(--step-0);
    line-height: 1.4;
  }
  .project-links {
    grid-column: 9 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-top: 0.9rem;
  }

  @media (max-width: 899px) {
    .panel-intro {
      min-height: 0;
    }
    .intro-foot .lead,
    .intro-index {
      grid-column: 1 / -1;
    }
    .project-meta {
      text-align: left;
    }
    .project-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .facts,
    .project-links {
      grid-column: 1 / -1;
    }
    .project-links {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.5rem;
      padding-top: 0;
    }
    .screen-phone {
      border-width: 4px;
      width: 24%;
    }
    .phone {
      width: 30%;
      border-width: 4px;
    }
  }
</style>
