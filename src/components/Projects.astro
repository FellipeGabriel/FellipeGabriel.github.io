---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ProjectLink from './ProjectLink.astro';
import QrCode from './QrCode.astro';
import galaxyPair from '../assets/space/galaxy-pair.jpg';
import { ui, routes, spaceCaptions, type Lang } from '../data/content';
import { projects } from '../data/projects';
import { sectionIds } from '../data/sections';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].projects;
const list = projects[lang];
const titleWidth = (name: string) => (name.length <= 6 ? 125 : 62);
---
<section id={sectionIds[lang].projects} class="projects" aria-labelledby="projects-title" data-projects>
  <div class="track" data-track>
    <div class="panel panel-intro field-ink" data-field="ink">
      <div class="intro-img projector" aria-hidden="true">
        <Picture quality={88} src={galaxyPair} formats={['avif', 'webp']} widths={[1000, 1600, 2400, 3200]} sizes="100vw" alt="" loading="lazy" />
      </div>
      <h2 id="projects-title" class="display intro-title" data-fit data-split>{t.heading}</h2>
      <p class="film-caption intro-caption" aria-hidden="true">{spaceCaptions.galaxyPair}</p>
      <p class="film-word intro-word" aria-hidden="true">{t.word}</p>
      <div class="intro-foot">
        <p class="lead">{t.lead}</p>
        <ol class="intro-index">
          {list.map((p) => (
            <li>
              <a href={routes[lang].project(p.slug)}>
                <span class="intro-name">{p.name}</span>
                <span class="label">{p.kind}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>

    {list.map((p) => (
      <article
        class={`panel panel-project field-${p.field} project-${p.slug}`}
        data-field={p.field}
        data-panel
        style={`--title-wdth:${titleWidth(p.name)}`}
        aria-labelledby={`p-${p.slug}`}
      >
        <h3 id={`p-${p.slug}`} class="display project-title" style={`view-transition-name: title-${p.slug}`}>
          {p.name}
        </h3>

        <div class="plate project-plate" data-plate style={`view-transition-name: plate-${p.slug}`}>
          {p.slug === 'lyfia' ? (
            <>
              <div class="shot shot-main" data-depth="0.06">
                <Picture quality={88} src={p.cover.src} formats={['avif', 'webp']} widths={[800, 1300, 2000]} sizes="(max-width: 760px) 100vw, 58vw" alt={p.cover.alt} loading="lazy" />
              </div>
              <div class="shot shot-phone" data-depth="-0.12">
                <Picture quality={88} src={p.secondary[0].src} formats={['avif', 'webp']} widths={[300, 520]} sizes="(max-width: 760px) 30vw, 13vw" alt={p.secondary[0].alt} loading="lazy" />
              </div>
            </>
          ) : (
            <div class="phones" data-depth="0.03">
              {[p.cover, ...p.secondary].map((s) => (
                <div class="phone">
                  <Picture quality={88} src={s.src} formats={['avif', 'webp']} widths={[320, 640]} sizes="(max-width: 760px) 30vw, 16vw" alt={s.alt} loading="lazy" />
                </div>
              ))}
            </div>
          )}
          {p.qr && <QrCode url={p.qr.url} label={p.qr.label} class="plate-qr" />}
          <p class="display project-ghost" aria-hidden="true">{p.name}</p>
        </div>

        <div class="project-body">
          <p class="label project-kind"><span class="project-code">{p.code}</span>{p.kind}</p>
          <p class="lead">{p.lead}</p>
          <ul class="facts">
            {p.facts.map((f) => <li>{f}</li>)}
          </ul>
          <div class="project-links">
            <a class="btn btn-solid" href={routes[lang].project(p.slug)}>{t.howItWasMade}<Icon name="arrow-right" /></a>
            {p.links.map((l) => <ProjectLink href={l.href} label={l.label} kind={l.kind} />)}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="track-progress" aria-hidden="true"><span data-track-progress></span></div>
</section>

<style>
  .projects {
    position: relative;
  }
  .track {
    display: flex;
    flex-direction: column;
  }
  .panel {
    position: relative;
    container-type: inline-size;
    padding: clamp(5rem, 12svh, 8rem) var(--pad) var(--pad);
  }

  .panel-intro {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-height: 100svh;
    overflow: hidden;
  }
  .intro-img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .intro-img :global(picture),
  .intro-img :global(img) {
    width: 100%;
    height: 100%;
  }
  .intro-img :global(img) {
    object-fit: cover;
    object-position: 50% 55%;
  }
  .intro-title {
    position: relative;
    z-index: 1;
    color: var(--paper);
    font-size: clamp(3.5rem, 15vw, 22rem);
  }
  .intro-caption,
  .intro-word {
    position: relative;
    z-index: 1;
  }
  .intro-caption {
    align-self: flex-end;
    margin-top: -1.25rem;
  }
  .intro-word {
    align-self: flex-start;
    margin-top: auto;
    margin-bottom: -0.5rem;
  }
  .intro-word + .intro-foot {
    margin-top: 0;
  }
  .intro-foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: end;
  }
  .intro-foot .lead {
    grid-column: 1 / span 5;
    background: var(--ink);
    padding: 1.25rem 1.5rem;
    max-width: none;
  }
  .intro-index {
    grid-column: 7 / -1;
    display: grid;
    background: var(--ink);
    padding: 0.5rem 1.5rem;
  }
  .intro-index li + li {
    border-top: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
  }
  .intro-index a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    text-decoration: none;
    transition: color 0.3s var(--ease-out);
  }
  .intro-index a:hover {
    color: var(--amber);
  }
  .intro-name {
    font-size: var(--step-3);
    font-weight: 900;
    font-variation-settings: 'wdth' 62;
    text-transform: uppercase;
    line-height: 0.9;
  }

  .panel-project {
    --title-size: 13.5cqw;
    --plate-l: 42cqw;
    --plate-t: clamp(5rem, 14svh, 9rem);
    --title-top: clamp(4.25rem, 9svh, 6rem);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .field-petrol {
    --ghost: var(--petrol);
    --plate-bg: var(--lyfia-cream);
  }
  .field-ink {
    --ghost: var(--ink);
    --plate-bg: var(--recupera-green);
  }
  .field-ink .project-title {
    color: var(--amber);
  }
  .project-title,
  .project-ghost {
    font-variation-settings: 'wdth' var(--title-wdth, 62);
  }
  .project-title {
    position: absolute;
    top: var(--title-top);
    left: var(--pad);
    font-size: var(--title-size);
    line-height: 0.8;
    z-index: 2;
    white-space: nowrap;
  }
  .project-plate {
    position: absolute;
    top: var(--plate-t);
    left: var(--plate-l);
    right: var(--pad);
    bottom: var(--pad);
    background: var(--plate-bg);
    z-index: 3;
  }
  .project-ghost {
    position: absolute;
    left: calc(var(--pad) - var(--plate-l));
    top: calc(var(--title-top) - var(--plate-t));
    font-size: var(--title-size);
    line-height: 0.8;
    color: var(--ghost);
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }
  .shot {
    position: absolute;
    overflow: hidden;
  }
  .shot :global(picture),
  .shot :global(img),
  .phone :global(picture),
  .phone :global(img) {
    width: 100%;
    height: 100%;
  }
  .shot :global(img),
  .phone :global(img) {
    object-fit: cover;
    object-position: 50% 0;
  }
  .project-lyfia .shot-main :global(img) {
    object-position: 0 0;
  }
  .project-lyfia .shot-main {
    inset: 0 -6% 0 0;
  }
  .project-lyfia .shot-phone {
    width: 22%;
    aspect-ratio: 390 / 844;
    right: 5%;
    bottom: -8%;
    border: 6px solid var(--ink);
    z-index: 3;
  }
  .phones {
    position: absolute;
    inset: 0 3% 5% 3%;
    container-type: size;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 3%;
  }
  .phone {
    flex: none;
    width: min(29cqw, (100cqh - 14rem) * 0.47);
    aspect-ratio: 720 / 1530;
    border: 6px solid var(--ink);
    background: var(--ink);
    overflow: hidden;
  }
  .project-plate :global(.plate-qr) {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 3;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    color: var(--ink);
  }
  .project-plate :global(.plate-qr .qr-code) {
    width: 6.5rem;
  }
  .project-plate :global(.plate-qr .qr-label) {
    max-width: 15ch;
    text-align: right;
    font-weight: 500;
    font-size: var(--step--1);
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  .project-body {
    position: relative;
    z-index: 2;
    margin-top: auto;
    max-width: calc(var(--plate-l) - var(--pad) * 2);
    display: grid;
    gap: 1rem;
  }
  .project-kind {
    color: var(--accent);
  }
  .project-code {
    display: block;
    color: var(--fg);
  }
  .facts {
    border-top: var(--rule) solid currentColor;
  }
  .facts li {
    padding: 0.55rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    font-size: var(--step-0);
    line-height: 1.35;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
  }

  .track-progress {
    display: none;
  }

  @media (min-width: 900px) {
    :global(html.motion) .track {
      flex-direction: row;
      width: max-content;
      height: 100svh;
    }
    :global(html.motion) .panel {
      height: 100svh;
      min-height: 0;
      flex: none;
      width: 100vw;
    }
    :global(html.motion) .track-progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 4px;
      z-index: 5;
    }
    .track-progress span {
      display: block;
      height: 100%;
      width: 100%;
      background: var(--amber);
      transform-origin: 0 50%;
      transform: scaleX(0);
    }
  }

  @media (min-width: 900px) and (max-height: 760px) {
    .panel-project .lead {
      font-size: var(--step-0);
    }
    .facts li {
      padding: 0.35rem 0;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 899px) {
    .panel-intro {
      min-height: 0;
    }
    .intro-word {
      display: none;
    }
    .intro-foot .lead,
    .intro-index {
      grid-column: 1 / -1;
    }
    .panel-project {
      min-height: 0;
      padding-top: 4.5rem;
    }
    .project-title {
      position: relative;
      top: auto;
      left: auto;
      font-size: min(var(--title-size) * 1.3, 24cqw);
    }
    .project-plate {
      position: relative;
      inset: auto;
      margin-top: 1.25rem;
      aspect-ratio: 4 / 3;
    }
    .project-ghost {
      display: none;
    }
    .phone {
      width: min(29cqw, (100cqh - 2rem) * 0.47);
    }
    .project-lyfia .shot-main {
      inset: 0;
    }
    .project-body {
      max-width: none;
      margin-top: 1.75rem;
    }
  }
</style>
