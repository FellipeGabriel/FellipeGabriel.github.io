---
import '../styles/global.css';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Fellipe Gabriel</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="field-orange nf">
    <main>
      <h1 class="display nf-code">404</h1>
      <div class="nf-cols">
        <p lang="pt-BR"><strong>Página não encontrada.</strong> Esse endereço não existe. <a href="/pt/">Ir para o início</a></p>
        <p lang="en"><strong>Page not found.</strong> This address doesn't exist. <a href="/en/">Go to the home page</a></p>
      </div>
    </main>
  </body>
</html>
<style>
  .nf { min-height: 100svh; margin: 0; padding: var(--pad); display: grid; align-content: end; }
  .nf-code { font-size: clamp(8rem, 42vw, 40rem); line-height: 0.8; }
  .nf-cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); margin-top: 2rem; font-size: var(--step-1); max-width: 70rem; }
  @media (max-width: 760px) { .nf-cols { grid-template-columns: 1fr; } }
</style>
